<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ch.zhaw.it.pm.humanangeryourself.ui.view.StartScreenViewController">
  <VBox alignment="CENTER" prefWidth="900.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
    <children>

      <!-- Title Area -->
      <VBox alignment="CENTER" prefHeight="300.0" style="-fx-border-color: black; -fx-border-width: 2;">
        <Text style="-fx-font-size: 80;" text="HUMAN ANGER" textAlignment="CENTER" />
        <Text style="-fx-font-size: 80;" text="YOURSELF" textAlignment="CENTER" />
      </VBox>

      <!-- Player Inputs -->
      <HBox alignment="CENTER" spacing="85">

        <TextField fx:id="player1Field" onKeyTyped="#validateField" promptText="Enter Player 1" style="-fx-border-color: black;" HBox.hgrow="ALWAYS">
          <font>
            <Font size="15.0" />
          </font>
        </TextField>

        <TextField fx:id="player2Field" onKeyTyped="#validateField" promptText="Enter Player 2" style="-fx-border-color: black;" HBox.hgrow="ALWAYS">
          <font>
            <Font size="15.0" />
          </font>
        </TextField>

        <TextField fx:id="player3Field" onKeyTyped="#validateField" promptText="Enter Player 3" style="-fx-border-color: black" HBox.hgrow="ALWAYS">
          <font>
            <Font size="15.0" />
          </font>
        </TextField>

        <TextField fx:id="player4Field" onKeyTyped="#validateField" promptText="Enter Player 4" style="-fx-border-color: black;" HBox.hgrow="ALWAYS">
          <font>
            <Font size="15.0" />
          </font>
        </TextField>

        <VBox.margin>
          <Insets bottom="30.0" top="30.0" />
        </VBox.margin>
      </HBox>

      <!-- Start Button -->
      <Button onAction="#startGame" prefHeight="50.0" prefWidth="200.0" style="-fx-font-size: 20px;" text="Start Game">
        <VBox.margin>
          <Insets top="40.0" />
        </VBox.margin>
      </Button>
    </children>
  </VBox>

  <!-- Settings Button -->
  <Button disable="true" onAction="#openSettings" prefHeight="30.0" prefWidth="150.0" style="-fx-font-size: 18px;" text="Settings" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0" />

</AnchorPane>
